#!../infernal

# Configuración
color_resultados = color("blue")
#-------------

NoEsLynds = false

kernel = uname
kernel_version = uname -r
so = uname -o
arquitectura = uname -m
host = uname -n

user_name = whoami
user_id = id -u

tiempo_encendido = uptime -p
fecha = date

infernal_shell = ps -p ?? -o comm=
shell = basename ?SHELL

distro_name = grep ^NAME= /etc/os-release | cut -d '"' -f 2
try
    distro_lynds_version = grep '^LYNDS_VERSION_FULL=' /etc/os-release | cut -d '=' -f 2 | awk '{print $1}'
    distro_lynds_codename = grep '^LYNDS_CODENAME=' /etc/os-release | cut -d '=' -f 2 | awk '{print $1}'
catch
    NoEsLynds = true
fi #linea 30
distro_based_raw = grep '^ID_LIKE=' /etc/os-release | cut -d '=' -f 2 | awk '{print $1}'
distro_based = capitalize(distro_based_raw)
distro_compatible_raw = grep '^VERSION_CODENAME=' /etc/os-release | cut -d '=' -f 2 | awk '{print $1}'
distro_compatible = capitalize(distro_compatible_raw)
distro_version_id = grep ^VERSION_ID= /etc/os-release | cut -d '"' -f 2
distro_version = grep ^VERSION= /etc/os-release | cut -d '"' -f 2

echo # Salto de linea
print(color("green") + "INFORMACIÓN SOBRE TU SISTEMA OPERATIVO")
echo
print("Tu sistema operativo es de tipo " + color(color_resultados) + so)
echo
print("Tu sistema operativo tiene el kernel " + color(color_resultados) + kernel)
print("La versión de tu kernel es " + color(color_resultados) + kernel_version)
echo
print("La arquitectura de tu procesador es " + color(color_resultados) + arquitectura)
echo
print("Tu usuario se llama " + color(color_resultados) + user_name)
print("El ID de tu usuario es " + color(color_resultados) + user_id)
echo
print("El hostname de tu ordenador es " + color(color_resultados) + host)
echo
print("Tienes el ordenador encendido " + color(color_resultados) + tiempo_encendido)
print("La fecha de tu ordenador indica que ahora mismo es " + color(color_resultados) + fecha)
echo
print("El shell que tienes configurado en Infernal se llama " + color(color_resultados) + infernal_shell)
print("El shell que tienes como shell de login en tu sistema operativo es " + color(color_resultados) + shell)
echo
print("Tu sistema operativo se llama " + color(color_resultados) + distro_name)
print("La versión de tu sistema operativo es " + color(color_resultados) + distro_version)
print("El ID de la versión de tu sistema operativo es " + color(color_resultados) + distro_version_id)
echo
if NoEsLynds == false then
    print("¡Tu sistema operativo es de " + color("green") + "Lynds Corp." + color("reset") + "! Y su versión es la " + color(color_resultados) + distro_lynds_version)
    print("Como tu sistema operativo es de " + color("green") + "Lynds Corp.," + color("reset") + " tiene su propio codename, pero mantiene el de Debian por compatibilidad de aplicaciones. Este codename es " + color(color_resultados) + distro_lynds_codename)
    echo
fi
print("Tu sistema operativo es compatible con los paquetes de " + color(color_resultados) + distro_compatible)
echo
