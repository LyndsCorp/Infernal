#!/bin/infernal

# Configuración
color_resultados = color("blue")
#-------------

kernel = uname
kernel_version = uname -r
so = uname -o
arquitectura = uname -m
host = uname -n

user_name = whoami
user_id = id -u

tiempo_encendido = uptime -p
fecha = date

infernal_shell = ps -p ?? -o comm= # NO VA, DEBERÍA DE TRADUCIR LOS 2 "??" LITERALMENTE EN "$$".
# Será porque termina por "="? Infernal debería detectar todo eso como un comando, ya que ps no es ni un bool ni nada, es un comando. Lo único que debería tocar Infernal allí es la expansión de comandos con $
# También:
###
user@lyndsos:~$ echo $$
16112
user@lyndsos:~$ dash -c echo $$

user@lyndsos:~$ dash -c "echo $$"
16112
user@lyndsos:~$ dash -c echo $$
###
# Tiene algo que ver con cómo Infernal ejecuta los comandos de shell.
# En el primer ejemplo, muestra el PID del Bash actual.
# En el segundo ejemplo, Dash recibe: -c echo\n16112 por la expansión de Bash.
# En el tercer ejemplo, lo mismo pero sin el salto de línea.
# Conclusión: he investigado un poco, y he encontrado que Infernal debería ejecutar los comandos con `SHELL -c 'comando'` en vez de `SHELL -c "comando"` ya que con comillas dobles, Bash expande el `$$` pero con comilla sola no.

# También añadir un comando infernal --apps-shell que te diga el shell direct no vendría nada mal
shell = basename ?SHELL

distro_name = grep ^NAME= /etc/os-release | cut -d '"' -f 2 # NO VA PORQUE TIENE COMILLAS ASÍ.
# Infernal debería que al detectar que no comienza la definición con comillas, saber que lo que se está definiendo es un comando de shell entonces las comillas y todo eso se deja igual, solo se hacen cosas con los $

echo # Salto de linea
print(color("green") + "INFORMACIÓN SOBRE TU SISTEMA OPERATIVO")
echo
print("Tu sistema operativo es de tipo " + color(color_resultados) + so)
echo
print("Tu sistema operativo tiene el kernel " + color(color_resultados) + kernel)
print("La versión de tu kernel es " + color(color_resultados) + kernel_version)
echo
print("La arquitectura de tu procesador es " + color(color_resultados) + arquitectura)
echo
print("Tu usuario se llama " + color(color_resultados) + user_name)
print("El ID de tu usuario es " + color(color_resultados) + user_id)
echo
print("El hostname de tu ordenador es " + color(color_resultados) + host)
echo
print("Tienes el ordenador encendido " + color(color_resultados) + tiempo_encendido)
print("La fecha de tu ordenador indica que ahora mismo es " + color(color_resultados) + fecha)
echo
print("El shell que tienes configurado en Infernal se llama " + color(color_resultados) + infernal_shell)
print("El shell que tienes como shell de login en tu sistema operativo es " + color(color_resultados) + shell)
echo
print("Tu sistema operativo se llama " + color(color_resultados) + distro_name)
