texto = "Hola Mundo"

print("=== lower / upper ===")
print(lower(texto))
print(upper(texto))

print("=== head ===")
print(head(texto, 4))
print(head(texto, "Hola"))
print(head(texto, "Mundo"))

print("=== tail ===")
print(tail(texto, 5))
print(tail(texto, "Mundo"))
print(tail(texto, "Hola"))

print("=== starts ===")
print(starts(texto, "Hola"))
print(starts(texto, "H"))
print(starts(texto, "Mundo"))

print("=== ends ===")
print(ends(texto, "Mundo"))
print(ends(texto, "o"))
print(ends(texto, "Hola"))

print("=== has ===")
print(has(texto, "la"))
print(has(texto, "Mun"))
print(has(texto, "Python"))

print("=== vacíos ===")
print(head("", 3))
print(tail("", 3))
print(head("Hola", 0)) #pues no existe 0 ya que comienza por 1
print(tail("Hola", 0))

print("=== head() y tail() con int enorme ===")
print(head("Hola", 100)) #no imprime caractéres de más
print(tail("Hola", 100))

print("=== head y tail sin nada especial  ===")
print(head("Hola", "")) #es como un starts() pero sin nada
print(tail("Hola", ""))

print("=== booleanos con starts(), ends() y has() ===")
print(starts("", ""))
print(ends("", ""))
print(has("", ""))

print("=== has() con string 2 vació ===")
print(has("Hola", ""))

print("=== contar texto (length() y count()) ===")
texto = "banana"
print(length(texto))           #6
print(count(texto, "a"))       #3
print(count(texto, "na"))      #2
print(count(texto, "banana"))  #1
print(count(texto, "x"))       #0
print(count(texto, ""))        #0
