#!../infernal
print("=== Creación de lista ===")

lista = ["David", "Linus", "Richard"]
print(lista)


print("=== Añadir elemento ===")

lista = lista + "Abracitos"[3]
print(lista)


print("=== Eliminar índice concreto ===")

lista = lista - [3]
print(lista)


print("=== Eliminar desde índice ===")

lista = ["a", "b", "c", "d", "e"]
print(lista)

lista = lista - [3*]
print(lista)



print("=== Vaciar lista completa ===")

lista = ["a", "b", "c"]
lista = lista - [*]
print(lista)


print("=== Eliminar antes del índice ===")

lista = ["a", "b", "c", "d", "e"]
lista = lista - [*3]
print(lista)


print("=== Mantener solo índice ===")

lista = ["a", "b", "c", "d", "e"]
lista = lista - [*3*]
print(lista)



print("=== Rangos ===")

lista = ["a", "b", "c", "d", "e", "f"]

lista = lista - [2:5]

print(lista)


print("=== Rango de un elemento ===")

lista = ["a", "b", "c"]

lista = lista - [3:3]

print(lista)




print("=== Selección de varios elementos ===")

lista = ["hola", "mundo", "desde", "Infernal"]

algo = lista[2:3]

print(algo)


print("=== Selección como string ===")

string texto = lista[1:4]

print(texto)


print("=== Lista numérica a string ===")

numeros = [1, 6, 10]

string convertido = numeros[1:3]

print(convertido)

###
print("=== Índices inválidos ===")

lista = ["a", "b"]

algo = lista[-1]

algo = lista[1.5]
###
#esos # significan que todo el bloque está comentado

